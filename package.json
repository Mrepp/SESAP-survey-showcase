{
  "name": "sesap-survey-showcase",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:e2e": "pnpm --filter @sesap/e2e test",
    "test:smoke": "pnpm --filter @sesap/smoke test",
    "test:pipeline": "pnpm --filter @sesap/full-pipeline test",
    "build": "turbo build",
    "dev": "turbo dev"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.69.0"
  },
  "dependencies": {
    "pnpm": "^10.30.3"
  }
}
